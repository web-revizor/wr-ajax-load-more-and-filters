<?xml version="1.0"?>
<ruleset name="WR Ajax Load More and Filters">
    <description>Security, WordPress API, i18n and PHP compatibility checks. Formatting rules of the full WordPress standard are not enforced.</description>

    <file>wr-ajax-load-more-and-filters.php</file>
    <file>uninstall.php</file>
    <file>inc</file>
    <file>template-parts</file>
    <!-- Generated at build time by the ui-kit sprite plugin. -->
    <exclude-pattern>/template-parts/sprite.php</exclude-pattern>

    <arg name="extensions" value="php"/>
    <!-- Warnings (slow-query hints, direct DB calls) are reported but do not fail CI. -->
    <config name="ignore_warnings_on_exit" value="1"/>
    <arg value="sp"/>

    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.0"/>

    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.PHP.DontExtract"/>
    <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DiscouragedFunctions"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wr-ajax-load-more-and-filters"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wralm"/>
                <element value="WRALM"/>
                <element value="Web_Revizor_Ajax_Load_More"/>
            </property>
        </properties>
        <!-- Views are required inside methods: their variables are function-local. -->
        <exclude-pattern>/inc/views/*</exclude-pattern>
    </rule>
    <rule ref="Generic.PHP.Syntax"/>
</ruleset>
